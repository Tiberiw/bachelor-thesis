PORT=3000
# Allowed frontend origin(s), comma-separated
FRONTEND_URL=http://localhost:4200

# Production: a single connection string (e.g. Neon), used over SSL. When set, the DB_* values below are ignored.
DATABASE_URL=

# Local development
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=thesis

JWT_SECRET=
JWT_EXPIRATION=8h

GOOGLE_CLIENT_ID=

# Base URL of the Gradio ASR service (model-inference/), e.g. https://tiberiw-thesis-asr.hf.space or http://localhost:7860
ASR_URL=
